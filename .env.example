DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=cod_report_app
DB_PASSWORD=replace-with-a-unique-strong-password
DB_NAME=cod_report
DB_ROOT_PASSWORD=replace-with-a-different-unique-strong-password
# 외부 DB 비밀번호와 AI API 키의 암호화 키 (긴 임의 문자열). 비워 두면 DB_PASSWORD 에서 키를 만듭니다.
# 한 번 정한 뒤 바꾸면 저장된 접속정보 비밀번호와 AI API 키를 다시 입력해야 합니다.
DATASOURCE_SECRET=
# HTTPS로 서비스할 때 true로 설정해 로그인 세션 쿠키를 Secure로 제한합니다.
COOKIE_SECURE=false
# 사내 AI 서버(Ollama) 주소. 양식 가져오기의 AI 문서 분석에서 "사내 AI 서버"로 사용합니다. 비워 두면 사용하지 않습니다.
OLLAMA_BASE_URL=
# 리포트 서버 접속 허용 범위. 127.0.0.1 이면 이 PC에서만, 0.0.0.0 이면 같은 네트워크의 다른 PC에서도 접속할 수 있습니다.
API_BIND_ADDRESS=127.0.0.1

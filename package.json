{
  "name": "cod-report",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "preview": "node server.js --production",
    "start": "node server.js --production",
    "test": "node --test",
    "db:up": "docker compose up -d --build",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:seed": "node scripts/seed-db.js"
  },
  "dependencies": {
    "@clickhouse/client": "1.24.1",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.4.0",
    "oracledb": "26.0.0",
    "pg": "8.23.1",
    "puppeteer-core": "^25.16.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "docx": "9.12.0",
    "echarts": "6.1.0",
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "jszip": "3.10.2",
    "pdfjs-dist": "6.4.299",
    "vite": "^6.1.0"
  }
}
